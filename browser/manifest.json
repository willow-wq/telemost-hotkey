{
  "manifest_version": 3,
  "name": "Telemost Right Shift Mic",
  "version": "0.2.0",
  "description": "Переключает микрофон выбранной клавишей в активной вкладке Телемоста.",
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": [
      "https://telemost.yandex.ru/*",
      "https://telemost.360.yandex.ru/*",
      "https://telemost.yandex.com/*",
      "https://telemost.360.yandex.com/*"
    ],
    "js": ["core.js", "settings.js", "content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "telemost-right-shift@example.invalid",
      "strict_min_version": "109.0"
    }
  }
}
